# ==============================================================================
# PatchProof Backend Environment Configuration
# ==============================================================================

# BharatCode Model Configuration (Judges: Configure your API key here)
# Base URL: Official OpenAI-compatible BharatCode API endpoint
BHARATCODE_BASE_URL=https://bharatcode.ai/api/model/v1
BHARATCODE_MODEL=qwen-3.8-27b
BHARATCODE_API_KEY=
BHARATCODE_TIMEOUT_SECONDS=60.0
BHARATCODE_MAX_RETRIES=2

# Offline / Demo Mode (Set to true to run deterministic workflow without API credits)
DEMO_MODE=false

# Model Context Protocol (MCP) Server Configuration
# MCP_API_KEY: Optional bearer token for HTTP/SSE transport security. Leave blank for open local mode.
MCP_API_KEY=
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_TRANSPORT=streamable-http

# Database Persistence
DATABASE_URL=sqlite:///./patchproof.db

# Server Binding
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Docker Sandbox Execution Limits (Phase 2)
DOCKER_PYTHON_IMAGE=python:3.12-slim
DOCKER_MEMORY_LIMIT=512m
DOCKER_NANO_CPUS=1000000000
DOCKER_PIDS_LIMIT=64
DOCKER_TIMEOUT_SECONDS=30
WORKSPACE_BASE_DIR=./workspaces
